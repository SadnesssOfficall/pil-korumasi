<Window x:Class="PilKorumasi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pil Koruması" Width="980" Height="700" MinWidth="860" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Icon="app.ico">
  <Border Background="{StaticResource Bg}" CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Height="52" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border Width="28" Height="28" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3DDC97" Offset="0" />
                <GradientStop Color="#1FA2FF" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" Foreground="#0E0F14" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Pil Koruması" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceText" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,2,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
          <Button Style="{StaticResource WinBtn}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Minimize_Click" ToolTip="Küçült" />
          <Button Style="{StaticResource WinBtn}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Close_Click" ToolTip="Tepsiye gizle" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="170" Height="170">
                  <Ellipse Stroke="#23263A" StrokeThickness="12" />
                  <Path x:Name="Arc" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource Accent}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PercentText" Text="--" Foreground="{StaticResource Fg}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StateIcon" Foreground="{StaticResource Muted}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock x:Name="StateText" Foreground="{StaticResource Fg}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="StateSub" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <Border x:Name="AdviceBox" CornerRadius="12" Padding="12,10" Margin="0,16,0,0" Background="#1A2A24">
                    <TextBlock x:Name="AdviceText" Foreground="#A7F3D0" FontSize="12.5" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,16,0,0">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="Pil sağlığı" />
                  <TextBlock x:Name="HealthText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="Güç" />
                  <TextBlock x:Name="RateText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="Sıcaklık" />
                  <TextBlock x:Name="TempText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="Voltaj" />
                  <TextBlock x:Name="VoltText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Kapasite" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="WearText" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
                <Grid Height="14" Margin="0,14,0,0">
                  <Border Background="#23263A" CornerRadius="7" />
                  <Border x:Name="HealthBar" CornerRadius="7" HorizontalAlignment="Left" Width="0">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3DDC97" Offset="0" />
                        <GradientStop Color="#1FA2FF" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <TextBlock x:Name="FullText" Foreground="{StaticResource Muted}" FontSize="12" />
                  <TextBlock x:Name="DesignText" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Text="Sağlık geçmişi" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="HistoryNote" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
                <Canvas x:Name="Chart" Height="120" Margin="0,14,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <CheckBox x:Name="ProtectionBox" Style="{StaticResource Toggle}" Checked="Setting_Changed" Unchecked="Setting_Changed">
                  <StackPanel>
                    <TextBlock Text="Koruma" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Sınırlara gelince haber verir" Foreground="{StaticResource Muted}" FontSize="12" />
                  </StackPanel>
                </CheckBox>

                <Grid Margin="0,22,0,0">
                  <TextBlock Text="Üst sınır" Foreground="{StaticResource Fg}" FontSize="13" />
                  <TextBlock x:Name="UpperText" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="UpperSlider" Minimum="50" Maximum="100" Margin="0,6,0,0" ValueChanged="Slider_Changed" />
                <TextBlock Text="Prizdeyken bu seviyeye gelince kabloyu çıkar uyarısı" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" />

                <Grid Margin="0,18,0,0">
                  <TextBlock Text="Alt sınır" Foreground="{StaticResource Fg}" FontSize="13" />
                  <TextBlock x:Name="LowerText" Foreground="{StaticResource Warn}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="LowerSlider" Minimum="10" Maximum="50" Margin="0,6,0,0" ValueChanged="Slider_Changed" />
                <TextBlock Text="Pildeyken bu seviyeye inince şarja tak uyarısı" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" />

                <Grid Margin="0,18,0,0">
                  <TextBlock Text="Isı uyarısı" Foreground="{StaticResource Fg}" FontSize="13" />
                  <TextBlock x:Name="HotText" Foreground="{StaticResource Bad}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="HotSlider" Minimum="35" Maximum="60" Margin="0,6,0,0" ValueChanged="Slider_Changed" />

                <Grid Margin="0,18,0,0">
                  <TextBlock Text="Hatırlatma aralığı" Foreground="{StaticResource Fg}" FontSize="13" />
                  <TextBlock x:Name="RemindText" Foreground="{StaticResource Fg}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="RemindSlider" Minimum="5" Maximum="60" Margin="0,6,0,0" ValueChanged="Slider_Changed" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
              <StackPanel>
                <CheckBox x:Name="GameBox" Style="{StaticResource Toggle}" Checked="Setting_Changed" Unchecked="Setting_Changed">
                  <StackPanel>
                    <TextBlock Text="Oyun modu" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Ekran kartı için prizde kalman gerekirken kabloyu çıkar uyarısını susturur" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="290" />
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="SoundBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed">
                  <TextBlock Text="Uyarı sesi" Foreground="{StaticResource Fg}" FontSize="13" />
                </CheckBox>
                <CheckBox x:Name="StartupBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Startup_Changed" Unchecked="Startup_Changed">
                  <TextBlock Text="Windows ile başlat (tepside)" Foreground="{StaticResource Fg}" FontSize="13" />
                </CheckBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Bilmen gereken" Foreground="{StaticResource Fg}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"
                           Text="Bu bilgisayar şarjı donanımdan durdurma ayarını Windows'a açmıyor; o yüzden uygulama şarjı kendisi kesemez, doğru anda haber verir. Üreticinin kontrol merkezinde şarj sınırı (Flexi Charger) varsa onu %80'e ayarlamak en iyisi." />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Style="{StaticResource Btn}" Content="Windows pil raporu" Click="Report_Click" />
                  <Button Style="{StaticResource Btn}" Content="Şimdi yenile" Margin="8,0,0,0" Click="Refresh_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
