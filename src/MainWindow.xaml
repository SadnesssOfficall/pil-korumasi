<Window x:Class="PilKorumasi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pil Koruması" Width="1020" Height="720" MinWidth="900" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" Icon="app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" ClipToBounds="True">
    <!-- Cam arkası: Windows 11'de akrilik üstüne ince renk, eski sürümlerde düz geçiş -->
    <Border x:Name="Backdrop" />

    <!-- Yavaşça süzülen iki renk lekesi; camın arkasında derinlik verir -->
    <Canvas IsHitTestVisible="False">
      <Ellipse x:Name="BlobA" Width="620" Height="620" Canvas.Left="-160" Canvas.Top="-220" Opacity="0.55">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#663EE2A0" Offset="0" />
            <GradientStop Color="#003EE2A0" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform>
          <TranslateTransform x:Name="BlobAMove" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="BlobB" Width="700" Height="700" Canvas.Left="520" Canvas.Top="260" Opacity="0.5">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#552A9DF4" Offset="0" />
            <GradientStop Color="#002A9DF4" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform>
          <TranslateTransform x:Name="BlobBMove" />
        </Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Başlık çubuğu -->
      <Grid Margin="20,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Pil Koruması" Foreground="{StaticResource Fg}" FontSize="14.5" FontWeight="SemiBold" />
            <TextBlock x:Name="DeviceText" Foreground="{StaticResource Faint}" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Glass}" Padding="4" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid>
            <Border x:Name="NavPill" CornerRadius="10" Background="#24FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Left" Width="0">
              <Border.RenderTransform>
                <TranslateTransform x:Name="NavPillMove" />
              </Border.RenderTransform>
            </Border>
            <StackPanel x:Name="NavBar" Orientation="Horizontal">
              <RadioButton x:Name="NavDurum" Style="{StaticResource NavBtn}" GroupName="nav" Tag="durum" Content="Durum" IsChecked="True" Checked="Nav_Checked" />
              <RadioButton x:Name="NavAyarlar" Style="{StaticResource NavBtn}" GroupName="nav" Tag="ayarlar" Content="Ayarlar" Checked="Nav_Checked" />
              <RadioButton x:Name="NavHakkinda" Style="{StaticResource NavBtn}" GroupName="nav" Tag="hakkinda" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Hakkında" />
                  <Ellipse x:Name="NavDot" Width="7" Height="7" Fill="{StaticResource Info}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Küçült" />
          <Button Style="{StaticResource WinBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Tepsiye gizle (arka planda çalışmaya devam eder)" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <!-- ============ DURUM ============ -->
        <ScrollViewer x:Name="PageDurum" VerticalScrollBarVisibility="Auto" Padding="22,6,22,22">
          <ScrollViewer.RenderTransform>
            <TranslateTransform />
          </ScrollViewer.RenderTransform>
          <StackPanel>
            <Border x:Name="UpdateBanner" Style="{StaticResource Glass}" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed" BorderBrush="#6060A5FA">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="#2860A5FA">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource Info}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="BannerTitle" Style="{StaticResource Title}" FontSize="13.5" />
                  <TextBlock Text="Ayarların ve geçmişin korunur, uygulama kendini yeniden başlatır." Style="{StaticResource Label}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button Style="{StaticResource Btn}" Content="Sonra" Click="BannerLater_Click" />
                  <Button Style="{StaticResource PrimaryBtn}" Content="Ayrıntılar" Margin="8,0,0,0" Click="BannerOpen_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="HeroCard" Style="{StaticResource Glass}" Padding="26">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="200" Height="200" HorizontalAlignment="Left">
                  <Ellipse Stroke="#16FFFFFF" StrokeThickness="14" />
                  <Path x:Name="ArcGlow" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.28">
                    <Path.Effect>
                      <BlurEffect Radius="14" />
                    </Path.Effect>
                  </Path>
                  <Path x:Name="Arc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PercentText" Text="--" Foreground="{StaticResource Fg}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                      <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                          <ScaleTransform x:Name="StateIconScale" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                      <TextBlock x:Name="StateShort" Foreground="{StaticResource Muted}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="StateText" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display, Segoe UI" />
                  <TextBlock x:Name="StateSub" Foreground="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <Border x:Name="AdviceBox" CornerRadius="14" Padding="14,11" Margin="0,18,0,0" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="AdviceIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,1,10,0" />
                      <TextBlock x:Name="AdviceText" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                    </Grid>
                  </Border>
                  <WrapPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Glass}" Padding="14,8" CornerRadius="12" Margin="0,0,10,0">
                      <CheckBox x:Name="QuickProtection" Style="{StaticResource Toggle}" Checked="Quick_Changed" Unchecked="Quick_Changed">
                        <TextBlock Text="Koruma" Foreground="{StaticResource Fg}" FontSize="13" />
                      </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Glass}" Padding="14,8" CornerRadius="12">
                      <CheckBox x:Name="QuickGame" Style="{StaticResource Toggle}" Checked="Quick_Changed" Unchecked="Quick_Changed" ToolTip="Ekran kartı için prizde kalman gerekirken &quot;kabloyu çıkar&quot; uyarısını susturur">
                        <TextBlock Text="Oyun modu" Foreground="{StaticResource Fg}" FontSize="13" />
                      </CheckBox>
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <UniformGrid x:Name="StatGrid" Columns="4" Margin="0,16,0,0">
              <Border Style="{StaticResource Glass}" Margin="0,0,8,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,1,7,0" />
                    <TextBlock Style="{StaticResource Label}" Text="Pil sağlığı" />
                  </StackPanel>
                  <TextBlock x:Name="HealthText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Glass}" Margin="4,0,4,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,1,7,0" />
                    <TextBlock Style="{StaticResource Label}" Text="Güç" />
                  </StackPanel>
                  <TextBlock x:Name="RateText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Glass}" Margin="4,0,4,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9CA;" Foreground="{StaticResource Bad}" FontSize="13" Margin="0,1,7,0" />
                    <TextBlock Style="{StaticResource Label}" Text="Sıcaklık" />
                  </StackPanel>
                  <TextBlock x:Name="TempText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Glass}" Margin="8,0,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE83E;" Foreground="{StaticResource Info}" FontSize="13" Margin="0,1,7,0" />
                    <TextBlock Style="{StaticResource Label}" Text="Voltaj" />
                  </StackPanel>
                  <TextBlock x:Name="VoltText" Style="{StaticResource Value}" Text="--" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid x:Name="BottomGrid" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Glass}">
                <StackPanel>
                  <TextBlock Text="Kapasite" Style="{StaticResource Title}" />
                  <TextBlock x:Name="WearText" Style="{StaticResource Label}" Margin="0,3,0,0" />
                  <Grid Height="12" Margin="0,18,0,0">
                    <Border Background="{StaticResource Track}" CornerRadius="6" />
                    <Border x:Name="HealthBar" CornerRadius="6" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentGradient}" />
                  </Grid>
                  <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="FullText" Style="{StaticResource Label}" />
                    <TextBlock x:Name="DesignText" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Foreground="{StaticResource Faint}"
                             Text="Sağlık, pilin bugün tam dolunca tuttuğu enerjinin yeniyken tuttuğuna oranıdır." />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Glass}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Sağlık geçmişi" Style="{StaticResource Title}" />
                    <TextBlock x:Name="HistoryNote" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <Canvas x:Name="Chart" Height="132" Margin="0,14,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ AYARLAR ============ -->
        <ScrollViewer x:Name="PageAyarlar" VerticalScrollBarVisibility="Auto" Padding="22,6,22,22" Visibility="Collapsed">
          <ScrollViewer.RenderTransform>
            <TranslateTransform />
          </ScrollViewer.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Glass}" Padding="22">
                <StackPanel>
                  <TextBlock Text="Sınırlar" Style="{StaticResource Title}" FontSize="16" />
                  <TextBlock Text="Pili bu aralıkta tutmak ömrünü uzatır." Style="{StaticResource Hint}" Margin="0,3,0,0" />

                  <Grid Margin="0,22,0,0">
                    <TextBlock Text="Üst sınır" Foreground="{StaticResource Fg}" FontSize="13" />
                    <TextBlock x:Name="UpperText" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="UpperSlider" Minimum="50" Maximum="100" Margin="0,6,0,2" ValueChanged="Slider_Changed" />
                  <TextBlock Text="Prizdeyken bu seviyeye gelince &quot;kabloyu çıkar&quot; uyarısı" Style="{StaticResource Hint}" />

                  <Grid Margin="0,20,0,0">
                    <TextBlock Text="Alt sınır" Foreground="{StaticResource Fg}" FontSize="13" />
                    <TextBlock x:Name="LowerText" Foreground="{StaticResource Warn}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="LowerSlider" Minimum="10" Maximum="50" Margin="0,6,0,2" Foreground="{StaticResource Warn}" ValueChanged="Slider_Changed" />
                  <TextBlock Text="Pildeyken bu seviyeye inince &quot;şarja tak&quot; uyarısı" Style="{StaticResource Hint}" />

                  <Grid Margin="0,20,0,0">
                    <TextBlock Text="Isı uyarısı" Foreground="{StaticResource Fg}" FontSize="13" />
                    <TextBlock x:Name="HotText" Foreground="{StaticResource Bad}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="HotSlider" Minimum="35" Maximum="60" Margin="0,6,0,2" Foreground="{StaticResource Bad}" ValueChanged="Slider_Changed" />
                  <TextBlock Text="Pil bu sıcaklığı geçince uyarır" Style="{StaticResource Hint}" />

                  <Grid Margin="0,20,0,0">
                    <TextBlock Text="Hatırlatma aralığı" Foreground="{StaticResource Fg}" FontSize="13" />
                    <TextBlock x:Name="RemindText" Foreground="{StaticResource Info}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <Slider x:Name="RemindSlider" Minimum="5" Maximum="60" Margin="0,6,0,2" Foreground="{StaticResource Info}" ValueChanged="Slider_Changed" />
                  <TextBlock Text="Aynı uyarı en fazla bu sıklıkla tekrarlanır" Style="{StaticResource Hint}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Glass}" Padding="22">
                <StackPanel>
                  <TextBlock Text="Davranış" Style="{StaticResource Title}" FontSize="16" />
                  <CheckBox x:Name="ProtectionBox" Style="{StaticResource Toggle}" Margin="0,18,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <StackPanel>
                      <TextBlock Text="Koruma" Foreground="{StaticResource Fg}" FontSize="13.5" />
                      <TextBlock Text="Sınırlara gelince ekranın sağ altında haber verir" Style="{StaticResource Hint}" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="GameBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <StackPanel>
                      <TextBlock Text="Oyun modu" Foreground="{StaticResource Fg}" FontSize="13.5" />
                      <TextBlock Text="Ekran kartı için prizde kalman gerekirken &quot;kabloyu çıkar&quot; uyarısını susturur" Style="{StaticResource Hint}" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="SoundBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <TextBlock Text="Uyarı sesi" Foreground="{StaticResource Fg}" FontSize="13.5" />
                  </CheckBox>
                  <CheckBox x:Name="StartupBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Startup_Changed" Unchecked="Startup_Changed">
                    <StackPanel>
                      <TextBlock Text="Windows ile başlat" Foreground="{StaticResource Fg}" FontSize="13.5" />
                      <TextBlock Text="Açılışta tepside sessizce çalışır" Style="{StaticResource Hint}" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Toggle}" Margin="0,16,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed">
                    <StackPanel>
                      <TextBlock Text="Güncellemeleri kendisi denetlesin" Foreground="{StaticResource Fg}" FontSize="13.5" />
                      <TextBlock Text="Açılışta ve 6 saatte bir bakar, yeni sürüm varsa haber verir" Style="{StaticResource Hint}" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Glass}" Padding="22" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Bilmen gereken" Style="{StaticResource Title}" />
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                             Text="Çoğu laptop şarjı belli bir yüzdede kesme ayarını Windows'a açmaz; o yüzden uygulama şarjı kendisi durduramaz, doğru anda haber verir. Üreticinin kontrol merkezinde şarj sınırı (Flexi Charger, Battery Health Charging, Conservation Mode) varsa onu %80'e ayarlamak en iyisi." />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource Btn}" Click="Report_Click" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="13" Margin="0,1,8,0" />
                        <TextBlock Text="Windows pil raporu" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Click="Refresh_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,1,8,0" />
                        <TextBlock Text="Şimdi yenile" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ============ HAKKINDA ============ -->
        <ScrollViewer x:Name="PageHakkinda" VerticalScrollBarVisibility="Auto" Padding="22,6,22,22" Visibility="Collapsed">
          <ScrollViewer.RenderTransform>
            <TranslateTransform />
          </ScrollViewer.RenderTransform>
          <StackPanel MaxWidth="640">
            <Border Style="{StaticResource Glass}" Padding="28">
              <StackPanel>
                <Image Source="logo.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
                <TextBlock Text="Pil Koruması" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="Prizde oynayan laptoplar için pil sağlığı takibi ve şarj uyarıları." Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border x:Name="UpdateCard" Style="{StaticResource Glass}" Padding="22" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="UpdateIconBox" Width="42" Height="42" CornerRadius="12" Background="#203EE2A0">
                    <TextBlock x:Name="UpdateIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                      <TextBlock.RenderTransform>
                        <RotateTransform x:Name="UpdateIconSpin" />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Title}" />
                    <TextBlock x:Name="UpdateSub" Style="{StaticResource Label}" Margin="0,3,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <Grid x:Name="ProgressRow" Height="8" Margin="0,18,0,0" Visibility="Collapsed">
                  <Border Background="{StaticResource Track}" CornerRadius="4" />
                  <Border x:Name="ProgressFill" Background="{StaticResource AccentGradient}" CornerRadius="4" HorizontalAlignment="Left" Width="0" />
                </Grid>

                <Border x:Name="NotesBox" Background="#0CFFFFFF" CornerRadius="12" Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="Yenilikler" Foreground="{StaticResource Fg}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="NotesText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>

                <WrapPanel Margin="0,18,0,0">
                  <Button x:Name="InstallBtn" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="Install_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,1,8,0" />
                      <TextBlock x:Name="InstallText" Text="İndir ve kur" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="CheckBtn" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Check_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,1,8,0" />
                      <TextBlock Text="Güncellemeleri denetle" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="SkipBtn" Style="{StaticResource Btn}" Content="Bu sürümü atla" Click="Skip_Click" Visibility="Collapsed" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Glass}" Padding="22" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Bağlantılar" Style="{StaticResource Title}" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://sorvia.net/urunler/pil-korumasi" Click="Link_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,1,8,0" />
                      <TextBlock Text="Sorvia sayfası" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://github.com/SadnesssOfficall/pil-korumasi" Click="Link_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="13" Margin="0,1,8,0" />
                      <TextBlock Text="Kaynak kod" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Btn}" Tag="https://github.com/SadnesssOfficall/pil-korumasi/issues" Click="Link_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="13" Margin="0,1,8,0" />
                      <TextBlock Text="Sorun bildir" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Faint}" Margin="0,14,0,0"
                           Text="Ücretsiz ve açık kaynak (MIT). Ayarlar ve geçmiş %APPDATA%\PilKorumasi klasöründe tutulur. Uygulama yalnızca güncelleme denetimi için GitHub'a bağlanır; pil verin bilgisayarından çıkmaz." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
